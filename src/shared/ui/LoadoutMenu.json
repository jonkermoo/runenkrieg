		"palette": "Grimoire",
		"scale": { "referenceHeight": 800, "min": 0.65, "max": 1.25 },
		"fitMargin": 16,
		"minTap": 32,
		"minText": 12,
		"textStroke": 0,
		"outline": 0,
		"corner": 0,
		"scrollBar": 4,
		"fonts": { "body": { "family": "SourceSansPro", "weight": "Bold", "file": "SourceSansPro-Bold.ttf" } }
	},
	"modal": true,
