--!strict
-- Natural building templates (references/village, flat-color style in docs/ART_STYLE.md).
-- Each template is ONE shape, generated by src/dev/Buildings and stored in the asset library;
-- placed copies vary by color scheme (Config/Palette.Buildings). Sizes in studs:
-- width = frontage (local X), depth = front to back (local Z, front at -Z). Same scale as the first
-- village (12-stud stories, Config/Metrics.Building).
-- class = destruction material class of the walls (Config/Destruction.Materials).

export type Template = {
	folder: string, -- library subfolder under Assets.Buildings
	width: number,
	depth: number,
	stories: number,
	storyHeight: number?, -- defaults to Metrics.Building.StoryHeight
	roofPitch: number,
	class: string,
	walls: { string }, -- allowed Palette.Buildings.Walls keys (picked per copy)
	roofs: { string }, -- allowed Palette.Buildings.Roofs keys
	chimneys: { number }?, -- local X positions as a fraction of half-width (-1..1)
	backDoor: boolean?,
	description: string,
}

local Buildings = {
	RoofOverhang = 1.4,
	Foundation = 0.6, -- floor top above the highest ground under the footprint
	WallThickness = 1,

	-- One at a time (user, 2026-10-09): start with a basic small house; add others once it's right.
	Templates = {
		SmallHouse = {
			folder = "Houses",
			width = 20,
			depth = 14,
			stories = 1,
			roofPitch = 35,
			class = "Plaster",
			walls = { "Whitewash", "Cream", "Sage", "Brick" },
			roofs = { "DarkTile", "Terracotta", "Slate" },
			chimneys = { 0.6 },
			description = "Basic one-story house: front door, windows on every wall, floor + ceiling, gabled roof, chimney.",
		},
	} :: { [string]: Template },

	-- Village placement: which templates appear along which kind of road (picked by hash).
	RoadTemplates = {
		Main = { "SmallHouse" },
		Lane = { "SmallHouse" },
		Row = { "SmallHouse" },
	},
}

return table.freeze(Buildings)
